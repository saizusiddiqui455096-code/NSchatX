# NS ChatX Environment Configuration

# Server Port
PORT=3000

# Node Environment
NODE_ENV=production

# Server Host
HOST=0.0.0.0

# WebSocket Settings
WS_HEARTBEAT_INTERVAL=30000

# Room Settings
ROOM_TTL_MS=3600000
TOKEN_TTL_MS=120000
HISTORY_MAX=200

# Security
ENABLE_CORS=true
CORS_ORIGIN=*

# Logging
LOG_LEVEL=info
